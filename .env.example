# Copy to .env.local for local work. On Vercel, enter these under Project Settings > Environment Variables.
# NEVER commit real values. Never put a secret value in a variable whose name starts with NEXT_PUBLIC_.

# ===== REQUIRED =====
# Supabase dashboard > Project Settings > API (or "Connect"): Project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys: the PUBLISHABLE key (sb_publishable_...).
# (Older projects: the legacy "anon" key.) Public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase dashboard > Project Settings > API Keys: the SECRET key (sb_secret_...).
# (Older projects: the legacy "service_role" key.) SERVER ONLY. Powers orders, uploads checks, admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# ===== RECOMMENDED =====
# Any long random string you generate yourself (e.g. 40+ random characters). Protects the daily cleanup job
# (/api/cron/cleanup). Vercel sends it to the cron job automatically. Without it, cleanup does not run.
CRON_SECRET=

# ===== NOT USED YET (leave unset) =====
# Online payments and notifications are not built. These names are reserved for later:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
